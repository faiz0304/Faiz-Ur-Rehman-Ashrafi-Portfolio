# ═══════════════════════════════════════════════════════════
# Faiz.AI Portfolio — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ═══════════════════════════════════════════════════════════

# ── Aura Neural Assistant (LLM Provider) ────────────────────
# Used exclusively in: src/app/api/aura/route.ts (server-side only)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Optional: OpenAI (if switching LLM provider) ─────────────
# Used exclusively in: src/app/api/aura/route.ts (server-side only)
# Obtain from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk_your_openai_api_key_here

# ── Vercel Analytics ─────────────────────────────────────────
# Automatically injected by Vercel — no manual configuration needed.
# VERCEL_ANALYTICS_ID is set automatically in the Vercel dashboard.
